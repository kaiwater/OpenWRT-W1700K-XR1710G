# OpenWrt config seed for Gemtek XR1710G (W1700K)
# Target/device + LuCI apps and their runtime dependencies only.
# Usage: cp configs/xr1710g-apps.seed .config && make defconfig

CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_gemtek_xr1710g-ubi=y
CONFIG_LUCI_LANG_zh_Hans=y

CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-base=y
